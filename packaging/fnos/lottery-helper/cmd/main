#!/bin/bash
set -euo pipefail

# fnOS runtime environment variables:
#   TRIM_APPDEST - Application installation directory (read-only)
#   TRIM_PKGVAR  - Application persistent data directory

APP_BIN="${TRIM_APPDEST}/server/lottery-helper-server"
DATA_DIR="${TRIM_PKGVAR:-/tmp/lottery-helper}"
PID_FILE="${DATA_DIR}/lottery-helper.pid"
LOG_FILE="${DATA_DIR}/lottery-helper.log"

export LOTTERY_HOST="${LOTTERY_HOST:-0.0.0.0}"
export LOTTERY_PORT="${LOTTERY_PORT:-18680}"
export LOTTERY_DB_PATH="${DATA_DIR}/lottery.db"

mkdir -p "${DATA_DIR}"

is_running() {
    if [ -f "${PID_FILE}" ]; then
        local pid
        pid=$(cat "${PID_FILE}" 2>/dev/null || true)
        if [ -n "${pid}" ] && kill -0 "${pid}" 2>/dev/null; then
            return 0
        fi
    fi
    return 1
}

start_app() {
    if is_running; then
        echo "lottery-helper is already running."
        return 0
    fi
    if [ ! -x "${APP_BIN}" ]; then
        echo "Error: executable not found or not executable: ${APP_BIN}" >> "${LOG_FILE}"
        return 1
    fi
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] Starting lottery-helper on ${LOTTERY_HOST}:${LOTTERY_PORT}..." >> "${LOG_FILE}"
    nohup "${APP_BIN}" >> "${LOG_FILE}" 2>&1 &
    local pid=$!
    echo "${pid}" > "${PID_FILE}"
    sleep 1
    if kill -0 "${pid}" 2>/dev/null; then
        return 0
    fi
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] Failed to start lottery-helper." >> "${LOG_FILE}"
    rm -f "${PID_FILE}"
    return 1
}

stop_app() {
    if ! is_running; then
        rm -f "${PID_FILE}"
        return 0
    fi
    local pid
    pid=$(cat "${PID_FILE}")
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] Stopping lottery-helper (PID ${pid})..." >> "${LOG_FILE}"
    kill "${pid}" 2>/dev/null || true
    for _ in $(seq 1 15); do
        if ! kill -0 "${pid}" 2>/dev/null; then
            break
        fi
        sleep 0.5
    done
    if kill -0 "${pid}" 2>/dev/null; then
        kill -9 "${pid}" 2>/dev/null || true
    fi
    rm -f "${PID_FILE}"
    return 0
}

case "${1:-}" in
    start)
        start_app
        ;;
    stop)
        stop_app
        ;;
    restart)
        stop_app
        start_app
        ;;
    status)
        if is_running; then
            exit 0
        else
            exit 3
        fi
        ;;
    *)
        echo "Usage: $0 {start|stop|restart|status}"
        exit 1
        ;;
esac
